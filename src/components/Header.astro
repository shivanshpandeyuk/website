---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---
<header class="site-header" transition:persist="site-header">
  <div class="wrap-wide site-header__inner">
    <a href="/" class="brand">{SITE.shortName}</a>
    <nav class="nav" aria-label="Primary">
      <span class="nav-indicator" aria-hidden="true"></span>
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/search/" aria-label="Search this site (⌘K)" title="Search (⌘K)" class="search-link" id="cmdk-trigger">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
      </a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </nav>
  </div>
</header>
<!-- Cmd+K command palette (E4/sub-part c): a sibling of <header>, but
     persisted alongside it so it opens from anywhere and survives
     client-side navigation. Morphs open from the search-icon button above:
     Header.astro's script computes the icon's on-screen offset from the
     panel's own centre and feeds it in as --cmdk-dx/--cmdk-dy so the panel
     visibly grows out of the icon rather than just fading in centred. -->
<div class="cmdk" id="cmdk" hidden transition:persist="cmdk">
  <div class="cmdk__backdrop" data-cmdk-dismiss></div>
  <div class="cmdk__panel" role="dialog" aria-modal="true" aria-labelledby="cmdk-heading">
    <div class="cmdk__head">
      <svg class="cmdk__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
      <span id="cmdk-heading" class="cmdk__label">Search</span>
      <kbd class="cmdk__esc">Esc</kbd>
      <button type="button" class="cmdk__close" data-cmdk-dismiss aria-label="Close search">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
      </button>
    </div>
    <div class="cmdk__body" id="cmdk-body"></div>
  </div>
</div>
<script is:inline data-astro-rerun>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme')
        || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>
<script is:inline>
  (() => {
    // The header carries transition:persist (E2: it never flashes on
    // navigation), so this DOM node and its scripts only run once for the
    // whole SPA session. aria-current is baked in at build time per page, so
    // after a client-side nav it goes stale on the persisted header unless we
    // recompute it here on every astro:page-load.
    const nav = document.querySelector('.nav');
    if (!nav) return;
    const indicator = nav.querySelector('.nav-indicator');
    const links = Array.from(nav.querySelectorAll('a[href]')).filter((a) => a !== indicator && !a.classList.contains('search-link'));
    const norm = (p) => p.replace(/\/$/, '') || '/';

    const placeIndicator = () => {
      const active = links.find((a) => a.getAttribute('aria-current') === 'page');
      if (!indicator || !active) { if (indicator) indicator.style.opacity = '0'; return; }
      const newLeft = active.offsetLeft;
      const newRight = nav.clientWidth - (active.offsetLeft + active.offsetWidth);
      // Two-edge spring (E4): give the edge travelling towards its new spot
      // a faster duration than the edge it's leaving behind, so the pill
      // stretches in the direction of travel then the trailing edge
      // catches up and settles, rather than sliding uniformly.
      const prevLeft = indicator.dataset.left === undefined ? null : parseFloat(indicator.dataset.left);
      if (prevLeft !== null && prevLeft !== newLeft) {
        const movingRight = newLeft > prevLeft;
        indicator.style.setProperty('--nav-ind-left-dur', movingRight ? '.44s' : '.24s');
        indicator.style.setProperty('--nav-ind-right-dur', movingRight ? '.24s' : '.44s');
      } else {
        indicator.style.setProperty('--nav-ind-left-dur', '.3s');
        indicator.style.setProperty('--nav-ind-right-dur', '.3s');
      }
      indicator.dataset.left = String(newLeft);
      indicator.style.opacity = '1';
      indicator.style.left = `${newLeft}px`;
      indicator.style.right = `${newRight}px`;
    };

    const sync = () => {
      const path = norm(location.pathname);
      links.forEach((a) => {
        const href = norm(new URL(a.getAttribute('href'), location.href).pathname);
        const current = href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
        if (current) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
      });
      placeIndicator();
    };

    sync();
    window.addEventListener('resize', placeIndicator);
    document.addEventListener('astro:page-load', sync);

    // Nav compresses into a floating pill once the page has scrolled a
    // little (E4/sub-part c). The header node is transition:persist'd so
    // this whole script only ever runs once per SPA session -- safe to
    // register the scroll listener here without a re-bind guard.
    const header = document.querySelector('.site-header');
    if (header) {
      let compact = false;
      let ticking = false;
      const applyCompact = () => {
        ticking = false;
        const shouldCompact = window.scrollY > 24;
        if (shouldCompact === compact) return;
        compact = shouldCompact;
        header.classList.toggle('site-header--compact', compact);
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(applyCompact);
      };
      applyCompact();
      window.addEventListener('scroll', onScroll, { passive: true });
      // Astro resets scroll position on a client-side route change, so the
      // header should un-compress along with it.
      document.addEventListener('astro:page-load', applyCompact);
    }

    // Cmd+K command palette (E4/sub-part c). Lives in this same persisted
    // IIFE so the keydown listener and open state survive navigation --
    // it's only ever registered once for the whole SPA session.
    const cmdk = document.getElementById('cmdk');
    const trigger = document.getElementById('cmdk-trigger');
    if (cmdk && trigger) {
      const panel = cmdk.querySelector('.cmdk__panel');
      const body = cmdk.querySelector('#cmdk-body');
      let paletteOpen = false;
      let hideTimer = null;
      let searchLoading = false;
      let lastFocused = null;

      // Pagefind's index + component script are only built into dist by
      // the post-build `pagefind` CLI step (see package.json), so they're
      // fetched lazily on first open rather than shipped on every page --
      // same assets the standalone /search/ page already uses.
      const loadSearch = () => {
        if (searchLoading) return;
        searchLoading = true;
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/pagefind/pagefind-component-ui.css';
        document.head.appendChild(link);
        const script = document.createElement('script');
        script.type = 'module';
        script.src = '/pagefind/pagefind-component-ui.js';
        script.addEventListener('load', () => {
          const input = document.createElement('pagefind-input');
          input.setAttribute('placeholder', 'Search notes, pitches and writing');
          body.append(input, document.createElement('pagefind-summary'), document.createElement('pagefind-results'));
          window.setTimeout(() => {
            const el = input.querySelector('input');
            if (el) el.focus();
          }, 30);
        });
        document.head.appendChild(script);
      };

      // FLIP-style offset: measure the panel's own centred resting spot
      // and the trigger icon's centre, then feed the delta in as a custom
      // property the CSS scales/translates away from on open.
      const positionFromTrigger = () => {
        const panelRect = panel.getBoundingClientRect();
        const triggerRect = trigger.getBoundingClientRect();
        panel.style.setProperty('--cmdk-dx', `${(triggerRect.left + triggerRect.width / 2) - (panelRect.left + panelRect.width / 2)}px`);
        panel.style.setProperty('--cmdk-dy', `${(triggerRect.top + triggerRect.height / 2) - (panelRect.top + panelRect.height / 2)}px`);
      };

      const openPalette = () => {
        if (paletteOpen) return;
        paletteOpen = true;
        lastFocused = document.activeElement;
        window.clearTimeout(hideTimer);
        cmdk.hidden = false;
        positionFromTrigger();
        document.documentElement.style.overflow = 'hidden';
        requestAnimationFrame(() => cmdk.classList.add('cmdk--open'));
        if (!body.childElementCount) loadSearch();
        else window.setTimeout(() => { const el = body.querySelector('input'); if (el) el.focus(); }, 60);
      };

      const closePalette = () => {
        if (!paletteOpen) return;
        paletteOpen = false;
        cmdk.classList.remove('cmdk--open');
        document.documentElement.style.overflow = '';
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        hideTimer = window.setTimeout(() => { cmdk.hidden = true; }, reduceMotion ? 0 : 260);
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      };

      trigger.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        openPalette();
      });
      cmdk.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('[data-cmdk-dismiss]')) closePalette();
      });
      cmdk.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const focusables = Array.from(panel.querySelectorAll('a[href], button, input, [tabindex]:not([tabindex="-1"])'))
          .filter((el) => el.offsetParent !== null);
        if (!focusables.length) return;
        const first = focusables[0], last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
      document.addEventListener('keydown', (e) => {
        const key = e.key.toLowerCase();
        if ((e.metaKey || e.ctrlKey) && key === 'k') {
          e.preventDefault();
          if (paletteOpen) closePalette(); else openPalette();
        } else if (e.key === 'Escape' && paletteOpen) {
          e.preventDefault();
          closePalette();
        }
      });
    }
  })();
</script>
