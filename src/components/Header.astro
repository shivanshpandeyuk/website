---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---
<header class="site-header" transition:persist="site-header">
  <div class="wrap-wide site-header__inner">
    <a href="/" class="brand">{SITE.shortName}</a>
    <nav class="nav" aria-label="Primary">
      <span class="nav-indicator" aria-hidden="true"></span>
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/search/" aria-label="Search this site" title="Search" class="search-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
      </a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </nav>
  </div>
</header>
<script is:inline data-astro-rerun>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme')
        || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>
<script is:inline>
  (() => {
    // The header carries transition:persist (E2: it never flashes on
    // navigation), so this DOM node and its scripts only run once for the
    // whole SPA session. aria-current is baked in at build time per page, so
    // after a client-side nav it goes stale on the persisted header unless we
    // recompute it here on every astro:page-load.
    const nav = document.querySelector('.nav');
    if (!nav) return;
    const indicator = nav.querySelector('.nav-indicator');
    const links = Array.from(nav.querySelectorAll('a[href]')).filter((a) => a !== indicator && !a.classList.contains('search-link'));
    const norm = (p) => p.replace(/\/$/, '') || '/';

    const placeIndicator = () => {
      const active = links.find((a) => a.getAttribute('aria-current') === 'page');
      if (!indicator || !active) { if (indicator) indicator.style.opacity = '0'; return; }
      indicator.style.opacity = '1';
      indicator.style.transform = `translateX(${active.offsetLeft}px)`;
      indicator.style.width = `${active.offsetWidth}px`;
    };

    const sync = () => {
      const path = norm(location.pathname);
      links.forEach((a) => {
        const href = norm(new URL(a.getAttribute('href'), location.href).pathname);
        const current = href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
        if (current) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
      });
      placeIndicator();
    };

    sync();
    window.addEventListener('resize', placeIndicator);
    document.addEventListener('astro:page-load', sync);

    // Nav compresses into a floating pill once the page has scrolled a
    // little (E4/sub-part c). The header node is transition:persist'd so
    // this whole script only ever runs once per SPA session -- safe to
    // register the scroll listener here without a re-bind guard.
    const header = document.querySelector('.site-header');
    if (header) {
      let compact = false;
      let ticking = false;
      const applyCompact = () => {
        ticking = false;
        const shouldCompact = window.scrollY > 24;
        if (shouldCompact === compact) return;
        compact = shouldCompact;
        header.classList.toggle('site-header--compact', compact);
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(applyCompact);
      };
      applyCompact();
      window.addEventListener('scroll', onScroll, { passive: true });
      // Astro resets scroll position on a client-side route change, so the
      // header should un-compress along with it.
      document.addEventListener('astro:page-load', applyCompact);
    }
  })();
</script>
