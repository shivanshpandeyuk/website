---
// Lightweight scroll-snap carousel. No dependencies.
// Adapted from a shadcn/embla "Gallery4" pattern into the site's own stack:
// arrows top-right, dot indicators below, drag/scroll on touch.
interface Props {
  title: string;
  moreHref?: string;
  moreLabel?: string;
  id?: string;
}
const { title, moreHref, moreLabel = 'View all', id } = Astro.props;
const cid = id ?? 'car-' + Math.random().toString(36).slice(2, 8);
---
<section class="car" data-car>
  <div class="section-head">
    <h2>{title}</h2>
    <div class="car__nav">
      <button class="car__btn" data-prev aria-label="Previous" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="car__btn" data-next aria-label="Next" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      {moreHref && <a class="more" href={moreHref}>{moreLabel} →</a>}
    </div>
  </div>
  <div class="car__track" data-track id={cid}>
    <slot />
  </div>
  <div class="car__dots" data-dots aria-hidden="true"></div>
</section>
<script>
  (() => {
    const init = (root) => {
      if (root.dataset.carReady) return;
      root.dataset.carReady = '1';
      const track = root.querySelector('[data-track]');
      const prev = root.querySelector('[data-prev]');
      const next = root.querySelector('[data-next]');
      const dots = root.querySelector('[data-dots]');
      if (!track) return;
      const cards = Array.from(track.children);
      const step = () => {
        const a = cards[0], b = cards[1];
        if (!a) return track.clientWidth;
        return b ? b.getBoundingClientRect().left - a.getBoundingClientRect().left : a.getBoundingClientRect().width;
      };
      // dots
      cards.forEach((_, i) => {
        const d = document.createElement('button');
        d.className = 'car__dot';
        d.type = 'button';
        d.setAttribute('aria-label', 'Go to item ' + (i + 1));
        d.addEventListener('click', () => track.scrollTo({ left: i * step(), behavior: 'smooth' }));
        dots.appendChild(d);
      });
      const update = () => {
        const i = Math.round(track.scrollLeft / step());
        Array.from(dots.children).forEach((d, n) => d.setAttribute('aria-current', n === i ? 'true' : 'false'));
        if (prev) prev.disabled = track.scrollLeft <= 4;
        if (next) next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
      };
      prev && prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next && next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
      window.addEventListener('resize', update);
      update();

      // Draggable, rubber-band carousel for mouse/trackpad pointers. Touch
      // already scrolls natively via overflow-x, so this only binds for
      // pointer:fine devices and skips synthetic dragging on touch.
      if (window.matchMedia('(pointer: fine)').matches) {
        let dragging = false, moved = false, startX = 0, startScroll = 0, overshoot = 0, raf = null, pid = null;
        const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const maxScroll = () => track.scrollWidth - track.clientWidth;
        const settle = () => {
          if (raf) cancelAnimationFrame(raf);
          if (reduceMotion() || overshoot === 0) { overshoot = 0; track.style.transform = ''; return; }
          const step2 = () => {
            overshoot *= 0.78;
            if (Math.abs(overshoot) < 0.5) { overshoot = 0; track.style.transform = ''; raf = null; return; }
            track.style.transform = `translateX(${overshoot}px)`;
            raf = requestAnimationFrame(step2);
          };
          raf = requestAnimationFrame(step2);
        };
        const end = () => {
          if (!dragging) return;
          dragging = false;
          track.classList.remove('car__track--dragging');
          track.style.scrollSnapType = '';
          settle();
          if (moved) {
            track.addEventListener('click', (ev) => { ev.preventDefault(); ev.stopPropagation(); }, { capture: true, once: true });
          }
        };
        track.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'touch') return;
          dragging = true; moved = false;
          startX = e.clientX; startScroll = track.scrollLeft;
          pid = e.pointerId;
        });
        track.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const dx = e.clientX - startX;
          if (!moved && Math.abs(dx) <= 4) return;
          if (!moved) {
            // Only take over the pointer once this is clearly a drag, so a plain
            // click still reaches the card link underneath.
            moved = true;
            track.classList.add('car__track--dragging');
            track.style.scrollSnapType = 'none';
            try { track.setPointerCapture(pid); } catch (_) {}
          }
          let target = startScroll - dx;
          const max = maxScroll();
          if (target < 0) { overshoot = -target * 0.35; target = 0; }
          else if (target > max) { overshoot = (max - target) * 0.35; target = max; }
          else { overshoot = 0; }
          track.scrollLeft = target;
          track.style.transform = overshoot ? `translateX(${overshoot}px)` : '';
        });
        track.addEventListener('pointerup', end);
        track.addEventListener('pointercancel', end);
        track.addEventListener('pointerleave', (e) => { if (dragging && e.buttons === 0) end(); });
      }
    };
    const run = () => document.querySelectorAll('[data-car]').forEach(init);
    run();
    // Re-init after client-side navigation (Astro view transitions).
    document.addEventListener('astro:page-load', run);
  })();
</script>
