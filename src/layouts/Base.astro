---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  ogType?: string;
  searchIndex?: boolean;
}
const { title, description = SITE.description, wide = false, searchIndex = true } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site ?? SITE.url).href} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name + ' — Writing'} href="/writing/rss.xml" />
    <!-- Fonts: self-contained. The CSS falls back to Palatino/Georgia (serif)
         and system-ui (sans), so the site has zero external dependencies and
         works on any host, offline. To use Newsreader + Inter instead, uncomment: -->
    <!--
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,560;6..72,600&display=swap" rel="stylesheet" />
    -->
    <!-- theme: set before paint to avoid flash -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header />
    <main data-pagefind-body={searchIndex || undefined} data-pagefind-ignore={searchIndex ? undefined : 'all'}>
      <div class={wide ? 'wrap-wide' : 'wrap'}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
