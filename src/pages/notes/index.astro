---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const topics = (await getCollection('topics', note => import.meta.env.DEV || !note.data.draft)).sort((a, b) =>
  a.data.year.localeCompare(b.data.year, undefined, { numeric:true }) ||
  a.data.paper.localeCompare(b.data.paper, undefined, { numeric:true }) ||
  a.data.section.localeCompare(b.data.section) ||
  a.data.order - b.data.order ||
  a.data.title.localeCompare(b.data.title, undefined, { numeric:true }));
const papers = [...new Set(topics.map(n => n.data.paper))];
const years = [...new Set(topics.map(n => n.data.year))];
// Browse tree: year -> paper -> section -> notes. Keyed on year+paper so the
// same paper name (e.g. "Paper 1 — Microeconomics") in Part I and Part IIB
// stays in separate groups.
const yearGroups = years.map((year, yi) => {
  const yearNotes = topics.filter(n => n.data.year === year);
  return {
    year, id: `year-${yi + 1}`,
    papers: [...new Set(yearNotes.map(n => n.data.paper))].map((paper, pi) => {
      const paperNotes = yearNotes.filter(n => n.data.paper === paper);
      return {
        paper, id: `year-${yi + 1}-paper-${pi + 1}`,
        sections: [...new Set(paperNotes.map(n => n.data.section))].map(section => ({
          title:section, notes:paperNotes.filter(n => n.data.section === section),
        })),
      };
    }),
  };
});
const files = (await getCollection('notes')).filter(n => n.data.files.length > 0);
---
<Base title="Cambridge notes" description="Economics notes from the Cambridge Tripos by Shivansh Pandey." wide>
  <div class="article-head">
    <p class="eyebrow">Cambridge Economics Tripos</p>
    <h1>Cambridge notes</h1>
    <p class="lead">My economics notes from Cambridge, organised by year, paper and topic. Shared in the spirit of the notes friends shared with me. Corrections welcome.</p>
  </div>

  <nav class="paper-nav" aria-label="Jump to a year and paper">
    {yearGroups.map(yg => <div class="paper-nav__group">
      <span class="paper-nav__year">{yg.year}</span>
      {yg.papers.map(pg => <a href={`#${pg.id}`}>{pg.paper}</a>)}
    </div>)}
  </nav>
  <form class="library-filters" id="library-filters" role="search" aria-label="Filter notes" hidden>
    <label class="filter-query">Find a topic<input id="topic-query" type="search" placeholder="For example, cointegration or matching" /></label>
    <div class="filter-group">
      <span class="filter-group__label" id="year-filter-label">Year</span>
      <div class="segmented" role="radiogroup" aria-labelledby="year-filter-label" id="year-filter">
        <span class="segmented__indicator" aria-hidden="true"></span>
        <button type="button" class="segmented__btn" role="radio" aria-checked="true" tabindex="0" data-value="">All years</button>
        {years.map(year => <button type="button" class="segmented__btn" role="radio" aria-checked="false" tabindex="-1" data-value={year}>{year}</button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-group__label" id="paper-filter-label">Paper</span>
      <div class="segmented" role="radiogroup" aria-labelledby="paper-filter-label" id="paper-filter">
        <span class="segmented__indicator" aria-hidden="true"></span>
        <button type="button" class="segmented__btn" role="radio" aria-checked="true" tabindex="0" data-value="">All papers</button>
        {papers.map(paper => <button type="button" class="segmented__btn" role="radio" aria-checked="false" tabindex="-1" data-value={paper}>{paper}</button>)}
      </div>
    </div>
    <button type="reset" class="btn">Reset</button>
  </form>
  <p class="library-count small muted" id="library-count" role="status" aria-live="polite">{topics.length} notes</p>
  <p class="small muted">Looking for something within a note? <a class="link" href="/search/">Search the full text →</a></p>

  <div id="notes-library">
    {yearGroups.map(yg => <section class="year-group" id={yg.id}>
      <h2 class="year-heading">{yg.year}</h2>
      {yg.papers.map(group => <section class="paper-group" id={group.id}>
        <div class="paper-heading"><p class="eyebrow">Economics Tripos</p><h3>{group.paper}</h3></div>
        {group.sections.map(section => <section class="topic-section">
          <h4>{section.title}</h4>
          <ul class="topic-list">
            {section.notes.map(note => <li class="topic-item" data-year={note.data.year} data-paper={note.data.paper} data-query={`${note.data.title} ${note.data.section} ${note.data.paper} ${note.data.year} ${note.data.description}`.toLocaleLowerCase('en-GB')}>
              <a href={`/notes/${note.id}/`}>
                <h5 transition:name={`note-title-${note.id}`}>{note.data.title}</h5>
                <p>{note.data.description}</p>
                <span class="topic-read" aria-hidden="true">Read note →</span>
              </a>
            </li>)}
          </ul>
        </section>)}
      </section>)}
    </section>)}
  </div>
  <p id="no-notes" class="empty-results" hidden>No notes match those filters. Try a broader topic or reset the filters.</p>

  {files.length > 0 && <section>
    <div class="section-head"><h2>Further notes</h2></div>
    {files.map(note => <div class="row">
      <h3>{note.data.year} · {note.data.paper}</h3>
      {note.data.files.map(file => <a class="link" href={file.href}>{file.label}</a>)}
    </div>)}
  </section>}

  <section>
    <div class="section-head"><h2>Resources</h2></div>
    <p class="muted" style="max-width:var(--measure); margin-bottom:1.25rem">
      Things that helped me, kept here so they help someone else. The concept notes
      and study guides below are Dr Kumar Aniket's, shared from
      <a class="link" href="https://aniket.co.uk/new/public/dos.html" target="_blank" rel="noopener">his teaching pages</a>;
      the course material and past papers are the Cambridge Economics Faculty's.
    </p>
    <div class="rows">
      <div class="row" style="align-items:flex-start">
        <div style="flex:1 1 20rem">
          <div class="row__title">Concept notes (Kumar Aniket)</div>
          <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">Short notes clarifying tricky ideas: difference-in-differences, OLS, the envelope theorem, duality, IS-LM and AA-DD, exchange-rate overshooting, and the maths (Lagrangians, Kuhn-Tucker, the Leibniz rule).</p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
          <a class="btn" href="https://aniket.co.uk/new/public/notes.html" target="_blank" rel="noopener">Open notes</a>
        </div>
      </div>
      <div class="row" style="align-items:flex-start">
        <div style="flex:1 1 20rem">
          <div class="row__title">Reading list &amp; Tripos study guide (Kumar Aniket)</div>
          <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">A fresher's reading list and a guide to how the Tripos fits together.</p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
          <a class="btn" href="https://www.aniket.co.uk/teaching/dos/readinglist-part1.pdf" target="_blank" rel="noopener">Reading list</a>
          <a class="btn" href="https://www.aniket.co.uk/teaching/Study_Guide.pdf" target="_blank" rel="noopener">Study guide</a>
        </div>
      </div>
      <div class="row" style="align-items:flex-start">
        <div style="flex:1 1 20rem">
          <div class="row__title">Cambridge Economics Faculty</div>
          <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">Official course material by part, and the past exam papers archive.</p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/ugrad/index.html?part=PI" target="_blank" rel="noopener">Part I</a>
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/ugrad/index.html?part=PIIA" target="_blank" rel="noopener">Part IIA</a>
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/ugrad/index.html?part=PIIB" target="_blank" rel="noopener">Part IIB</a>
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/exams/" target="_blank" rel="noopener">Past papers</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
// Segmented pill filter (year/paper): same two-edge spring technique as the
// nav indicator and theme-toggle knob in Header.astro (leading edge -- the
// one travelling toward its new spot -- runs a faster transition than the
// trailing edge, so the pill stretches then settles rather than sliding
// uniformly). Uses left+width rather than left+right because the track can
// scroll horizontally on narrow screens, and an absolutely positioned
// descendant's `right` offset doesn't track a scrolling ancestor's content
// the way `left`/`width` do.
function setupSegmented(root: HTMLElement, onChange: () => void) {
  const indicator = root.querySelector<HTMLElement>('.segmented__indicator');
  const btns = [...root.querySelectorAll<HTMLButtonElement>('.segmented__btn')];
  if (!indicator || btns.length === 0) return { value: () => '', reset: () => {} };

  const place = () => {
    const active = btns.find(b => b.getAttribute('aria-checked') === 'true');
    if (!active) { indicator.style.opacity = '0'; return; }
    const newLeft = active.offsetLeft;
    const newWidth = active.offsetWidth;
    const prevLeft = indicator.dataset.left === undefined ? null : parseFloat(indicator.dataset.left);
    if (prevLeft !== null && prevLeft !== newLeft) {
      const movingRight = newLeft > prevLeft;
      indicator.style.setProperty('--seg-ind-left-dur', movingRight ? '.44s' : '.24s');
      indicator.style.setProperty('--seg-ind-right-dur', movingRight ? '.24s' : '.44s');
    } else {
      indicator.style.setProperty('--seg-ind-left-dur', '.3s');
      indicator.style.setProperty('--seg-ind-right-dur', '.3s');
    }
    indicator.dataset.left = String(newLeft);
    indicator.style.opacity = '1';
    indicator.style.left = `${newLeft}px`;
    indicator.style.width = `${newWidth}px`;
  };

  const select = (btn: HTMLButtonElement, { focus = false } = {}) => {
    btns.forEach(b => { const on = b === btn; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
    place();
    if (focus) btn.focus();
    btn.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    onChange();
  };

  btns.forEach((btn, i) => {
    btn.addEventListener('click', () => select(btn));
    btn.addEventListener('keydown', event => {
      const dir = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1
        : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1
        : event.key === 'Home' ? -Infinity
        : event.key === 'End' ? Infinity
        : 0;
      if (!dir) return;
      event.preventDefault();
      const next = btns[Math.max(0, Math.min(btns.length - 1, dir === Infinity ? btns.length - 1 : dir === -Infinity ? 0 : i + dir))];
      select(next, { focus: true });
    });
  });

  window.addEventListener('resize', place);
  place();
  return {
    value: () => btns.find(b => b.getAttribute('aria-checked') === 'true')?.dataset.value ?? '',
    reset: () => select(btns[0]),
  };
}

function setupLibraryFilters() {
  const form = document.querySelector<HTMLFormElement>('#library-filters');
  const query = document.querySelector<HTMLInputElement>('#topic-query');
  const yearRoot = document.querySelector<HTMLElement>('#year-filter');
  const paperRoot = document.querySelector<HTMLElement>('#paper-filter');
  const items = [...document.querySelectorAll<HTMLElement>('.topic-item')];
  if (!form || form.dataset.ready || !query || !yearRoot || !paperRoot) return;
  function filterNotes() {
    const words = query!.value.trim().toLocaleLowerCase('en-GB').split(/\s+/).filter(Boolean);
    const yearValue = year.value();
    const paperValue = paper.value();
    let count = 0;
    for (const item of items) {
      item.hidden = !words.every(word => item.dataset.query!.includes(word)) ||
        (!!yearValue && item.dataset.year !== yearValue) ||
        (!!paperValue && item.dataset.paper !== paperValue);
      if (!item.hidden) count++;
    }
    document.querySelectorAll<HTMLElement>('.topic-section, .paper-group, .year-group').forEach(group => {
      group.hidden = ![...group.querySelectorAll<HTMLElement>('.topic-item')].some(item => !item.hidden);
    });
    document.querySelector('#library-count')!.textContent = `${count} ${count === 1 ? 'note' : 'notes'}`;
    (document.querySelector('#no-notes') as HTMLElement).hidden = count !== 0;
  }
  const year = setupSegmented(yearRoot, filterNotes);
  const paper = setupSegmented(paperRoot, filterNotes);
  form.dataset.ready = '1';
  form.hidden = false;
  form.addEventListener('submit', event => event.preventDefault());
  form.addEventListener('input', filterNotes);
  form.addEventListener('reset', () => { query.value = ''; year.reset(); paper.reset(); filterNotes(); });
}
setupLibraryFilters();
// Re-run after client-side navigation (Astro view transitions).
document.addEventListener('astro:page-load', setupLibraryFilters);
</script>
<style>
  .article-head { max-width:46rem; }
  .paper-nav { display:flex; flex-direction:column; gap:.75rem; margin-bottom:2rem; font-size:.9rem; }
  .paper-nav__group { display:flex; flex-wrap:wrap; gap:.6rem 1rem; align-items:baseline; }
  .paper-nav__year { font-family:var(--font-sans); font-size:.72rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); flex:0 0 100%; }
  .paper-nav a { text-underline-offset:.25em; color:var(--accent); }
  @media (min-width:700px) { .paper-nav__year { flex:0 0 9rem; } }
  .library-filters { display:flex; align-items:end; flex-wrap:wrap; gap:1rem; padding:1.25rem; background:var(--surface-2); border:1px solid var(--border); border-radius:var(--radius); }
  [hidden] { display:none !important; }
  .library-filters label { display:grid; gap:.4rem; font-size:.8rem; font-weight:600; flex:1 1 10rem; }
  .library-filters .filter-query { flex:2 1 18rem; }
  input { width:100%; min-width:0; min-height:44px; padding:.6rem .75rem; border:1px solid var(--border-strong); border-radius:var(--radius-sm); background:var(--surface); color:var(--text); font:inherit; font-weight:400; font-size:.9rem; }
  input:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  /* Segmented year/paper filter (DESIGN.md E4): replaces plain <select>s
     with a pill radiogroup carrying the same two-edge spring indicator as
     the nav pill and theme-toggle knob in Header.astro (see setupSegmented
     below) -- the leading edge (the one moving toward its new spot) runs a
     faster transition than the trailing edge, so the pill visibly
     stretches then settles rather than sliding uniformly. */
  .filter-group { display:flex; flex-direction:column; gap:.4rem; flex:1 1 14rem; min-width:0; }
  .filter-group__label { font-size:.8rem; font-weight:600; }
  .segmented {
    position:relative; display:flex; gap:.15rem; min-height:44px;
    padding:.2rem; border:1px solid var(--border-strong); border-radius:999px;
    background:var(--surface); overflow-x:auto; scrollbar-width:none;
  }
  .segmented::-webkit-scrollbar { display:none; }
  .segmented__indicator {
    position:absolute; top:.2rem; bottom:.2rem; left:0; z-index:0;
    border-radius:999px; background:var(--surface-2); opacity:0; pointer-events:none;
    transition: left var(--seg-ind-left-dur, .34s) cubic-bezier(.22, 1.04, .36, 1),
      width var(--seg-ind-right-dur, .34s) cubic-bezier(.22, 1.04, .36, 1), opacity .15s ease;
  }
  .segmented__btn {
    position:relative; z-index:1; flex:0 0 auto; white-space:nowrap;
    padding:.5rem .85rem; font:inherit; font-size:.82rem; font-weight:500;
    color:var(--muted); background:transparent; border:0; border-radius:999px;
    cursor:pointer; transition:color .15s ease;
  }
  .segmented__btn:hover { color:var(--text); }
  .segmented__btn[aria-checked='true'] { color:var(--text); font-weight:600; }
  .segmented__btn:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  @media (prefers-reduced-motion: reduce) {
    .segmented__indicator { transition: opacity .15s ease; }
  }
  .library-count { margin-top:1rem; }
  .year-group { margin-top:4rem; scroll-margin-top:6rem; }
  .year-group:first-child { margin-top:1.5rem; }
  .year-heading { font-size:clamp(1.5rem, 3.5vw, 1.9rem); padding-bottom:.6rem; border-bottom:2px solid var(--text); }
  .paper-group { margin-top:3.5rem; scroll-margin-top:6rem; }
  .year-heading + .paper-group { margin-top:2rem; }
  .paper-heading { padding-bottom:1.25rem; border-bottom:1px solid var(--border-strong); }
  .paper-heading h3 { font-size:1.35rem; }
  .topic-section { margin-top:2rem; }
  .topic-section > h4 { margin-bottom:1rem; font-family:var(--font-sans); font-size:1rem; }
  .topic-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; list-style:none; padding:0; }
  .topic-item { display:flex; min-width:0; }
  .topic-item a { display:flex; flex-direction:column; width:100%; padding:1.4rem; text-decoration:none; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); transition:border-color .15s; }
  .topic-item a:hover { border-color:var(--accent); }
  .topic-item h5 { font-family:var(--font-sans); font-size:1.35rem; font-weight:500; line-height:1.2; margin:0 0 .6rem; letter-spacing:-0.018em; color:var(--text); }
  .topic-item p { color:var(--muted); font-size:.86rem; line-height:1.5; margin-bottom:1rem; }
  .topic-read { margin-top:auto; font-size:.8rem; color:var(--accent); }
  .empty-results { margin:2rem 0; padding:1.5rem; border:1px solid var(--border); border-radius:var(--radius); }
  @media (max-width:620px) { .topic-list { grid-template-columns:1fr; } }
</style>
