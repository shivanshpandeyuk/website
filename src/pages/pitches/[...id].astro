---
import Base from '../../layouts/Base.astro';
import ReaderEnhancements from '../../components/ReaderEnhancements.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pitches = await getCollection('pitches', (p) => p.data.status !== 'draft');
  return pitches.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const d = entry.data;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const badgeClass = (r?: string) => 'badge badge--' + (r ?? 'watch').toLowerCase();
---
<Base title={`${d.company} (${d.ticker})`} description={d.thesis} ogType="article">
  <p><a class="back-link" href="/pitches">← All pitches</a></p>

  {d.cover && (
    <div class="pitch-hero">
      <div class="pitch-hero__img" style={`background-image:url('${d.cover}')`} transition:name={`pitch-cover-${entry.id}`}></div>
      <span class="pitch-hero__ghost" aria-hidden="true">{d.ticker}</span>
      <div class="pitch-hero__cap">
        <div class="pcard__meta" style="margin-bottom:.3rem">
          <span class="pcard__ticker" style="font-size:1rem" transition:name={`pitch-ticker-${entry.id}`}>{d.ticker}</span>
          {d.exchange && <span style="font-size:.82rem;color:rgba(255,255,255,.72)">{d.exchange}</span>}
          {d.recommendation && <span class={'pcard__rec pcard__rec--' + d.recommendation.toLowerCase()}>{d.recommendation}</span>}
        </div>
        <h1 style="color:#fff;font-size:clamp(1.9rem,4vw,2.6rem)" transition:name={`pitch-title-${entry.id}`}>{d.company}</h1>
      </div>
    </div>
  )}

  <div class:list={["reader-shell", sections.length === 0 && "reader-shell--two-col"]}>
    <aside class="reader-shell__toc" data-pagefind-ignore>
      <p class="reader-shell__label">Tearsheet</p>
      <dl class="tearsheet" data-pagefind-ignore>
        <div><dt>Ticker</dt><dd>{d.ticker}</dd></div>
        {d.exchange && <div><dt>Exchange</dt><dd>{d.exchange}</dd></div>}
        {d.sector && <div><dt>Sector</dt><dd>{d.sector}</dd></div>}
        <div><dt>Date</dt><dd>{fmt(d.date)}</dd></div>
        {d.recommendation && <div><dt>Stance</dt><dd>{d.recommendation}</dd></div>}
      </dl>
    </aside>
    <article class="reader-shell__main">
      <div class="article-head">
        {!d.cover && (
          <>
            <div class="card__meta" style="font-size:.9rem">
              <span class="card__ticker" style="font-size:1rem" transition:name={`pitch-ticker-${entry.id}`}>{d.ticker}</span>
              {d.exchange && <span class="faint">{d.exchange}</span>}
              {d.recommendation && <span class={badgeClass(d.recommendation)}>{d.recommendation}</span>}
            </div>
            <h1 transition:name={`pitch-title-${entry.id}`}>{d.company}</h1>
          </>
        )}
        <p class="lead" style="font-size:1.15rem">{d.thesis}</p>
        <div class="article-meta" data-pagefind-ignore>
          {d.pdf && <a class="link" href={d.pdf} target="_blank" rel="noopener">Full deck (PDF)</a>}
          <button type="button" class="copy-link" data-copy-link aria-label="Copy link to this page">
            <span class="copy-link__icons" aria-hidden="true">
              <svg class="copy-link__icon copy-link__icon--copy" viewBox="0 0 20 20" width="14" height="14"><path d="M7 3h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 7H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              <svg class="copy-link__icon copy-link__icon--check" viewBox="0 0 20 20" width="14" height="14"><path d="M4 10.5 8 14l8-9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>Copy link</span>
          </button>
        </div>
      </div>

      <dl class="tearsheet" data-pagefind-ignore>
        <div><dt>Ticker</dt><dd>{d.ticker}</dd></div>
        {d.exchange && <div><dt>Exchange</dt><dd>{d.exchange}</dd></div>}
        {d.sector && <div><dt>Sector</dt><dd>{d.sector}</dd></div>}
        <div><dt>Date</dt><dd>{fmt(d.date)}</dd></div>
        {d.recommendation && <div><dt>Stance</dt><dd>{d.recommendation}</dd></div>}
      </dl>

      <p class="figure-help small muted" hidden>Open any figure to view it at full size in a new tab.</p>
      <div class="prose">
        <Content />
      </div>

      <p class="faint small" style="margin-top:2.75rem; border-top:1px solid var(--border); padding-top:1.25rem">
        For information and discussion only. Not investment advice, not a recommendation, and not a solicitation. Figures are tagged [R] reported, [C] calculated, [E] estimate, [U] unverified; check them against primary sources before you rely on any of them.
      </p>
    </article>
    {sections.length > 0 && (
      <aside class="reader-shell__side" data-pagefind-ignore>
        <p class="reader-shell__label">On this page</p>
        <nav aria-label="Contents" class="pitch-toc">
          <ul>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </nav>
      </aside>
    )}
  </div>
  <ReaderEnhancements />
</Base>
