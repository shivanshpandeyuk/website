---
import Base from '../../layouts/Base.astro';
import PitchCard from '../../components/PitchCard.astro';
import { getCollection } from 'astro:content';

const pitches = (await getCollection('pitches', (p) => p.data.status !== 'draft'))
  .sort((a, b) => (b.data.order - a.data.order) || (b.data.date.valueOf() - a.data.date.valueOf()));
---
<Base title="Stock pitches" description="Equity research and stock pitches by Shivansh Pandey." wide>
  <div class="article-head">
    <p class="eyebrow">Equity research</p>
    <h1>Stock pitches</h1>
    <p class="lead">Long and short ideas I have worked up, written to read on the page: the thesis, the numbers, the charts, and what would have to be true. Figures carry provenance tags. None of it is investment advice.</p>
  </div>

  {pitches.length === 0 ? (
    <p class="muted">Pitches are being published shortly.</p>
  ) : (
    <div class="pcard-grid">
      {pitches.map((p) => <PitchCard entry={p} />)}
    </div>
  )}
</Base>
