---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import PitchCard from '../components/PitchCard.astro';
import { getCollection } from 'astro:content';
import { SITE, SOCIALS } from '../consts';

const pitches = (await getCollection('pitches', (p) => p.data.status !== 'draft'))
  .sort((a, b) => (b.data.order - a.data.order) || (b.data.date.valueOf() - a.data.date.valueOf()));

const writing = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
const badgeClass = (r?: string) => 'badge badge--' + (r ?? 'watch').toLowerCase();
---
<Base>
  <section class="hero">
    <p class="eyebrow">Shivansh Pandey</p>
    <h1>Economics, statistics,<br />and equity research.</h1>
    <p class="lead">
      I read Economics at Gonville &amp; Caius, Cambridge, and I am starting an M.S.
      in Statistics at LSE this autumn. This site has my Cambridge economics notes,
      stock pitches, programming projects and dissertation. I want it to be an
      investment blog and an education blog at once.
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:.6rem; margin-top:.4rem">
      <a class="btn btn--accent" href="/pitches">Stock pitches</a>
      <a class="btn" href="/notes">Cambridge notes</a>
      <a class="btn" href="/writing">Writing</a>
    </div>
    <p class="muted small" style="margin-top:.4rem">
      <strong style="color:var(--text)">Currently</strong>
      &nbsp;·&nbsp; M.S. Statistics, LSE (from autumn 2026)
      <span class="dot">·</span> last summer, equity research at Rothschild &amp; Co / Redburn Atlantic
    </p>
  </section>

  <section>
    <p class="prose" style="max-width:var(--measure)">
      At Cambridge I finished with a first, and 84% in my final year. The faculty
      gave my dissertation its prize for the best piece of econometrics that year:
      it looked at the UK's superfast broadband subsidies and found a "copper trap",
      where subsidies for copper broadband held back the rollout of fibre.
      I spent summer 2026 on Rothschild
      &amp; Co / Redburn Atlantic's software and cloud desk, building the JFrog and
      Garmin models from scratch and a live tracker of the datacentre build-out
      worldwide; before that a $500m software acquisition at Bending Spoons, and
      infrastructure valuations at EY-Parthenon.
    </p>
  </section>

  {pitches.length > 0 && (
    <Carousel title="Selected pitches" moreHref="/pitches" moreLabel="All pitches">
      {pitches.map((p) => <PitchCard entry={p} />)}
    </Carousel>
  )}

  {writing.length > 0 && (
    <section>
      <div class="section-head">
        <h2>Recent writing</h2>
        <a class="more" href="/writing">All writing →</a>
      </div>
      <div class="rows">
        {writing.map((w) => (
          <div class="row">
            <a class="row__title" href={`/writing/${w.id}`}>{w.data.title}</a>
            <span class="row__date">{w.data.category} · {fmt(w.data.date)}</span>
            <p class="row__desc">{w.data.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="section-head"><h2>Elsewhere</h2></div>
    <div style="display:grid; grid-template-columns: 1fr auto; gap:1.5rem; align-items:start">
      <p class="muted">
        Reach me at <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        {SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => (
          <> <span class="dot">·</span> <a class="link" href={s.href} target="_blank" rel="me noopener">{s.label}</a></>
        ))}
        <br /><br />
        Corrections on anything here are welcome, especially on the notes and the numbers.
      </p>
      <div class="li-badge">
        <div class="badge-base LI-profile-badge" data-locale="en_US" data-size="medium" data-theme="light" data-type="VERTICAL" data-vanity="shivansh-pandey-uk" data-version="v1">
          <a class="badge-base__link LI-simple-link" href="https://uk.linkedin.com/in/shivansh-pandey-uk?trk=profile-badge">Shivansh P.</a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline src="https://platform.linkedin.com/badges/js/profile.js" async defer type="text/javascript"></script>
</Base>
