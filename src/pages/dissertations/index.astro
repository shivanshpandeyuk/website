---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const items = (await getCollection('dissertations'))
  .sort((a, b) => (b.data.order - a.data.order) || b.data.year.localeCompare(a.data.year));
const rendered = await Promise.all(items.map(async (e) => ({ e, Content: (await render(e)).Content })));
---
<Base title="Dissertations" description="Long-form and dissertation work by Shivansh Pandey.">
  <div class="article-head">
    <p class="eyebrow">Long-form research</p>
    <h1>Dissertations</h1>
    <p class="lead">Extended pieces of independent research and dissertation work.</p>
  </div>

  {rendered.length === 0 ? (
    <p class="muted">Dissertation write-ups are being added shortly.</p>
  ) : (
    <div class="stack" style="--gap:2rem">
      {rendered.map(({ e, Content }) => (
        <article class="card diss-card">
          <div class="diss-card__main">
            <p class="eyebrow">{e.data.level}</p>
            <h2 class="diss-card__title">{e.data.title}</h2>
            <div class="prose">
              <p class="muted"><strong style="color:var(--text)">Abstract.</strong> {e.data.abstract}</p>
              <Content />
            </div>
          </div>
          <aside class="diss-card__side">
            <dl class="tearsheet">
              <div><dt>Degree</dt><dd>{e.data.level}</dd></div>
              <div><dt>Year</dt><dd>{e.data.year}</dd></div>
              {e.data.grade && <div><dt>Recognition</dt><dd>{e.data.grade}</dd></div>}
              {e.data.tags?.length > 0 && <div><dt>Methods</dt><dd>{e.data.tags.join(' · ')}</dd></div>}
            </dl>
            {e.data.pdf && <a class="btn btn--accent" href={e.data.pdf} target="_blank" rel="noopener">Read the full dissertation (PDF)</a>}
          </aside>
        </article>
      ))}
    </div>
  )}
</Base>
